<?xml version="1.0" encoding="utf-8"?>

<set xmlns:android="http://schemas.android.com/apk/res/android">

    <alpha
        android:duration="350"
        android:fromAlpha="0"
        android:toAlpha="1" />

    <translate
        android:duration="350"
        android:fromYDelta="20dp"
        android:toYDelta="0dp" />

    <scale
        android:duration="350"
        android:fromXScale="0.96"
        android:fromYScale="0.96"
        android:toXScale="1"
        android:toYScale="1"
        android:pivotX="50%"
        android:pivotY="50%" />

</set>