<?xml version="1.0" encoding="utf-8"?>

<set xmlns:android="http://schemas.android.com/apk/res/android">

    <alpha
        android:duration="450"
        android:fromAlpha="0"
        android:toAlpha="1" />

    <translate
        android:duration="450"
        android:fromYDelta="30dp"
        android:toYDelta="0dp" />

    <scale
        android:duration="450"
        android:fromXScale="0.9"
        android:fromYScale="0.9"
        android:toXScale="1"
        android:toYScale="1"
        android:pivotX="50%"
        android:pivotY="50%" />

</set>