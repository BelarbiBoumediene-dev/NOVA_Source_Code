<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="oval">
            <solid android:color="#16000000" />
            <stroke
                android:width="10dp"
                android:color="#55F5A623" />
        </shape>
    </item>

    <item android:inset="4dp">
        <shape android:shape="oval">
            <solid android:color="#18130A" />
            <stroke
                android:width="3dp"
                android:color="#F5A623" />
        </shape>
    </item>

    <item android:inset="7dp">
        <shape android:shape="oval">
            <stroke
                android:width="1dp"
                android:color="#FFE3A3" />
        </shape>
    </item>

</layer-list>
