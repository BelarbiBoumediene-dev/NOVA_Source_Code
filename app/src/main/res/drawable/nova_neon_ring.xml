<?xml version="1.0" encoding="utf-8"?>

<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Outer purple glow -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#16000000" />

            <stroke
                android:width="10dp"
                android:color="#554B1FFF" />
        </shape>
    </item>

    <!-- Main neon ring -->
    <item android:inset="4dp">
        <shape android:shape="oval">

            <solid android:color="#100B20" />

            <stroke
                android:width="3dp"
                android:color="#9B5CFF" />

        </shape>
    </item>

    <!-- Inner bright ring -->
    <item android:inset="7dp">
        <shape android:shape="oval">

            <stroke
                android:width="1dp"
                android:color="#D9B8FF" />

        </shape>
    </item>

</layer-list>