<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Low, dark lower layer creates a physical card edge. -->
    <item android:top="5dp">
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <solid android:color="#060814" />
            <stroke android:width="1dp" android:color="#18294F" />
        </shape>
    </item>
    <!-- Main illuminated plane. -->
    <item android:bottom="5dp">
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <gradient android:angle="315" android:startColor="#263D78" android:centerColor="#172342" android:endColor="#101629" />
            <stroke android:width="1dp" android:color="#4D79C7" />
        </shape>
    </item>
    <!-- Top highlight line. -->
    <item android:gravity="top|center_horizontal" android:width="220dp" android:height="2dp" android:top="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="2dp" />
            <solid android:color="#9CC6FF" />
        </shape>
    </item>
</layer-list>
