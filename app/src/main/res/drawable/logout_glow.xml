<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item
        android:left="4dp"
        android:top="4dp"
        android:right="4dp"
        android:bottom="4dp">

        <shape android:shape="rectangle">

            <corners android:radius="22dp" />

            <gradient
                android:angle="0"
                android:startColor="#001F0000"
                android:centerColor="#666B1FCC"
                android:endColor="#001F0000" />

        </shape>

    </item>

    <item
        android:left="12dp"
        android:top="12dp"
        android:right="12dp"
        android:bottom="12dp">

        <shape android:shape="rectangle">

            <corners android:radius="18dp" />

            <solid android:color="#556B1FCC" />

        </shape>

    </item>

</layer-list>