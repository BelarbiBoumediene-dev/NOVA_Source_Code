<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_victory">

    <!-- ========================================================= -->
    <!-- BACKGROUND -->
    <!-- ========================================================= -->

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/plantwo"
        android:scaleType="centerCrop"
        android:alpha="0.16"
        android:contentDescription="@null" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#D9070A16" />


    <!-- ========================================================= -->
    <!-- MAIN CONTENT -->
    <!-- ========================================================= -->

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:scrollbars="none"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="22dp"
        android:paddingBottom="28dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <!-- ================================================= -->
            <!-- VICTORY AREA -->
            <!-- ================================================= -->

            <FrameLayout
                android:layout_width="210dp"
                android:layout_height="210dp"
                android:layout_marginTop="30dp">

                <!-- Outer glow -->

                <View
                    android:layout_width="210dp"
                    android:layout_height="210dp"
                    android:alpha="0.20"
                    android:background="@drawable/bg_victory_medallion" />

                <!-- Middle ring -->

                <View
                    android:layout_width="170dp"
                    android:layout_height="170dp"
                    android:layout_gravity="center"
                    android:alpha="0.38"
                    android:background="@drawable/bg_logo" />

                <!-- Inner panel -->

                <View
                    android:layout_width="138dp"
                    android:layout_height="138dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_logo" />

                <ImageView
                    android:id="@+id/resultImage"
                    android:layout_width="108dp"
                    android:layout_height="108dp"
                    android:layout_gravity="center"
                    android:src="@drawable/img1"
                    android:scaleType="centerInside"
                    android:contentDescription="Quest Complete" />

                <!-- Victory mark -->

                <TextView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="bottom|end"
                    android:gravity="center"
                    android:text="✓"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_logo" />

            </FrameLayout>


            <!-- ================================================= -->
            <!-- TITLE -->
            <!-- ================================================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="QUEST COMPLETE"
                android:textColor="#F5F7FF"
                android:textSize="26sp"
                android:textStyle="bold"
                android:letterSpacing="0.06" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="MISSION ACCOMPLISHED"
                android:textColor="#8B5CF6"
                android:textSize="9sp"
                android:textStyle="bold"
                android:letterSpacing="0.20" />


            <!-- ================================================= -->
            <!-- SCORE -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="19dp"
                android:paddingBottom="19dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:background="@drawable/bg_logo">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FINAL SCORE"
                    android:textColor="#78839F"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.18" />

                <TextView
                    android:id="@+id/scoreText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="75%"
                    android:textColor="#F5F7FF"
                    android:textSize="48sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/resultMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-2dp"
                    android:gravity="center"
                    android:text="Great work!"
                    android:textColor="#78839F"
                    android:textSize="13sp" />

            </LinearLayout>


            <!-- ================================================= -->
            <!-- REWARD -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="15dp"
                android:background="@drawable/bg_logo">

                <!-- XP ICON -->

                <LinearLayout
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:gravity="center"
                    android:background="@drawable/bg_logo">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="XP"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                </LinearLayout>


                <!-- REWARD TEXT -->

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="13dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="REWARD UNLOCKED"
                        android:textColor="#78839F"
                        android:textSize="8sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.14" />

                    <TextView
                        android:id="@+id/xpText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="+50 XP"
                        android:textColor="#A78BFA"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/coinsText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:textColor="#F2B84B"
                        android:textSize="12sp"
                        android:textStyle="bold"
                       />

                </LinearLayout>


                <!-- CHECK -->

                <TextView
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:gravity="center"
                    android:text="✓"
                    android:textColor="#A78BFA"
                    android:textSize="19sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <!-- ================================================= -->
            <!-- CONTINUE BUTTON -->
            <!-- ================================================= -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/doneButton"
            style="@style/Widget.Quizz.PremiumButton"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="20dp"
                android:text="CONTINUE JOURNEY   →"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:backgroundTint="#4F8CFF"
                app:cornerRadius="17dp"
                app:elevation="4dp" />


            <!-- SAVE STATUS -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="✓  PROGRESS SAVED"
                android:textColor="#626D89"
                android:textSize="8sp"
                android:textStyle="bold"
                android:letterSpacing="0.10" />


            <!-- ================================================= -->
            <!-- FOOTER -->
            <!-- ================================================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="NOVA  •  EVERY GOAL IS A QUEST"
                android:textColor="#626D89"
                android:textSize="8sp"
                android:textStyle="bold"
                android:letterSpacing="0.16" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
