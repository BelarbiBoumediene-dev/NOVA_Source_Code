<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_world_map"

    >

    <!-- ===================================================== -->
    <!-- CINEMATIC BACKGROUND                                  -->
    <!-- ===================================================== -->

    <ImageView
        android:id="@+id/gameBackground"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/plantwo"
        android:scaleType="centerCrop"
        android:alpha="0.18"
        android:contentDescription="@null"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- A decorative world beacon sits behind the content layer. -->
    <View
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_marginTop="-76dp"
        android:layout_marginEnd="-66dp"
        android:alpha="0.38"
        android:background="@drawable/bg_hologram_orb"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />



    <!-- ===================================================== -->
    <!-- SCROLLABLE CONTENT                                    -->
    <!-- ===================================================== -->

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingBottom="28dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="0dp"
            android:paddingBottom="20dp">

            <!-- ================================================= -->
            <!-- JOURNEY HEADER                                     -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="34dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="#332E6CFF"
                        android:paddingStart="10dp"
                        android:paddingTop="6dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="6dp"
                        android:text="ACTIVE WORLD"
                        android:textColor="#BBD2FF"
                        android:textSize="8sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.15" />
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:text="SECTOR 01  •  EXPLORATION"
                        android:textColor="#75839F"
                        android:textSize="8sp"
                        android:textStyle="bold"
                        android:gravity="end"
                        android:letterSpacing="0.10" />
                </LinearLayout>


                <TextView
                    android:id="@+id/journeyTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:text="Kotlin Adventure"
                    android:textColor="#F5F7FF"
                    android:textSize="30sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.01"
                    android:lineSpacingExtra="3dp" />

                <TextView
                    android:id="@+id/journeyDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:text="Your learning adventure."
                    android:textColor="#78839F"
                    android:textSize="14sp"
                    android:lineSpacingExtra="5dp" />

            </LinearLayout>

            <!-- ================================================= -->
            <!-- COMPANION CARD                                     -->
            <!-- ================================================= -->

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                app:cardBackgroundColor="#151D39"
                app:cardCornerRadius="22dp"
                app:cardElevation="8dp"
                app:strokeColor="#466AA9"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp">

                    <!-- AVATAR -->

                    <FrameLayout
                        android:layout_width="82dp"
                        android:layout_height="92dp"
                        android:padding="5dp">

                        <ImageView
                            android:id="@+id/companionAvatar"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/img1"
                            android:scaleType="fitCenter"
                            android:contentDescription="Companion" />

                    </FrameLayout>

                    <!-- COMPANION INFO -->

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="YOUR COMPANION"
                            android:textColor="#A78BFA"
                            android:textSize="9sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.12" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:text="Adventure Guide"
                            android:textColor="#F5F7FF"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/companionLevelText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="Level 1 • Ready for adventure"
                            android:textColor="#78839F"
                            android:textSize="12sp"
                            android:lineSpacingExtra="3dp" />

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- ================================================= -->
            <!-- DESTINATION                                       -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical">

                    <View
                        android:layout_width="3dp"
                        android:layout_height="17dp"
                        android:background="#4F8CFF" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="YOUR DESTINATION"
                        android:textColor="#78839F"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.12" />

                </LinearLayout>

                <TextView
                    android:id="@+id/goalText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Learn Kotlin"
                    android:textColor="#F5F7FF"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:lineSpacingExtra="4dp" />

            </LinearLayout>

            <!-- ================================================= -->
            <!-- PLAYER STATUS / XP                                -->
            <!-- ================================================= -->

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="23dp"
                app:cardBackgroundColor="#101629"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp"
                app:strokeColor="#283452"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="19dp">

                    <!-- HEADER -->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="PLAYER STATUS"
                                android:textColor="#A78BFA"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.15" />

                            <TextView
                                android:id="@+id/xpText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="9dp"
                                android:text="⚡ 0 XP  •  Level 1"
                                android:textColor="#F5F7FF"
                                android:textSize="17sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="✦"
                            android:textColor="#8B5CF6"
                            android:textSize="25sp" />

                    </LinearLayout>

                    <!-- DIVIDER -->

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="18dp"
                        android:background="#263451" />

                    <!-- QUEST PROGRESS -->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="17dp"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="QUEST PROGRESS"
                            android:textColor="#78839F"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.10" />

                        <TextView
                            android:id="@+id/progressText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 / 3 Chapters completed  •  0%"
                            android:textColor="#6EA8FF"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <!-- PROGRESS BAR -->

                    <ProgressBar
                        android:id="@+id/progressBar"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:layout_marginTop="13dp"
                        android:max="100"
                        android:progress="0"
                        android:progressTint="#4F8CFF"
                        android:progressBackgroundTint="#263452"
                        android:indeterminate="false" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Complete chapters to earn XP and advance."
                        android:textColor="#626D89"
                        android:textSize="11sp"
                        android:lineSpacingExtra="3dp" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- ================================================= -->
            <!-- WORLD MAP                                         -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:gravity="center_vertical">

                <View
                    android:layout_width="3dp"
                    android:layout_height="19dp"
                    android:background="#4F8CFF" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="WORLD MAP"
                        android:textColor="#F5F7FF"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.10" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="YOUR ADVENTURE PATH"
                        android:textColor="#626D89"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.10" />

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_game_icon_button"
                    android:paddingStart="11dp"
                    android:paddingEnd="11dp"
                    android:paddingTop="7dp"
                    android:paddingBottom="7dp"
                    android:text="CHAPTERS"
                    android:textColor="#6EA8FF"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.06" />

            </LinearLayout>

            <!-- ================================================= -->
            <!-- DYNAMIC CHAPTERS                                  -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/chaptersContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="17dp"
                android:orientation="vertical" />

            <!-- ================================================= -->
            <!-- FOOTER                                            -->
            <!-- ================================================= -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:gravity="center"
                android:text="✦  EVERY CHAPTER TAKES YOU FURTHER  ✦"
                android:textColor="#3F4963"
                android:textSize="9sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
