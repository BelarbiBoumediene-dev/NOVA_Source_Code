<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_world_map"
    android:clipToPadding="false"
    android:overScrollMode="never">

    <!-- ========================================================= -->
    <!-- CINEMATIC GAME BACKGROUND                                 -->
    <!-- ========================================================= -->

    <ImageView
        android:id="@+id/gameBackground"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/plantwo"
        android:scaleType="centerCrop"
        android:alpha="0.20"
        android:contentDescription="@null"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Dark cinematic layer -->

    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#B8070A16"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ========================================================= -->
    <!-- GAME SCROLL AREA                                          -->
    <!-- ========================================================= -->

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:overScrollMode="never"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="24dp"
            android:paddingBottom="42dp">

            <!-- ================================================= -->
            <!-- GAME HEADER                                       -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="NOVA QUEST"
                        android:textColor="#6EA8FF"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.22" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="ADVENTURE MAP"
                        android:textColor="#F5F7FF"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.04" />

                </LinearLayout>



            </LinearLayout>

            <!-- ================================================= -->
            <!-- CHAPTER HERO                                      -->
            <!-- ================================================= -->

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardBackgroundColor="#0E162A"
                app:cardCornerRadius="26dp"
                app:cardElevation="0dp"
                app:strokeColor="#2B3F68"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="22dp">

                    <!-- TOP QUEST BAR -->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical">

                        <View
                            android:layout_width="4dp"
                            android:layout_height="20dp"
                            android:background="#4F8CFF" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp"
                            android:text="CHAPTER 01"
                            android:textColor="#6EA8FF"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.18" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ACTIVE"
                            android:textColor="#A78BFA"
                            android:textSize="8sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.12" />

                    </LinearLayout>

                    <!-- TITLE -->

                    <TextView
                        android:id="@+id/chapterTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="13dp"
                        android:text="The Village of Kotlin"
                        android:textColor="#F5F7FF"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        android:lineSpacingExtra="2dp" />

                    <!-- DESCRIPTION -->

                    <TextView
                        android:id="@+id/chapterDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="9dp"
                        android:text="Learn the foundations of Kotlin."
                        android:textColor="#78839F"
                        android:textSize="14sp"
                        android:lineSpacingExtra="4dp" />

                    <!-- QUEST STATUS -->

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:gravity="center_vertical"
                        android:background="#16122B"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="◆  ACTIVE QUEST"
                            android:textColor="#A78BFA"
                            android:textSize="9sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.08" />

                    </LinearLayout>

                    <!-- PROGRESS -->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:orientation="vertical">



                        <View
                            android:layout_width="match_parent"
                            android:layout_height="5dp"
                            android:layout_marginTop="8dp"
                            android:background="#202B45" />

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- ================================================= -->
            <!-- YOUR PATH                                         -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:gravity="center_vertical">

                <View
                    android:layout_width="4dp"
                    android:layout_height="20dp"
                    android:background="#4F8CFF" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="YOUR PATH"
                        android:textColor="#F5F7FF"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.10" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="QUEST STAGES"
                        android:textColor="#626D89"
                        android:textSize="8sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.10" />

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚔ LESSONS"
                    android:textColor="#6EA8FF"
                    android:textSize="8sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:background="#101A31"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp" />

            </LinearLayout>

            <!-- ================================================= -->
            <!-- QUEST MAP                                         -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/lessonContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical" />

            <!-- ================================================= -->
            <!-- FINAL BOSS                                        -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:gravity="center_vertical">

                <View
                    android:layout_width="4dp"
                    android:layout_height="20dp"
                    android:background="#8B5CF6" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="FINAL BOSS"
                        android:textColor="#F5F7FF"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.10" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="COMPLETE THE CHAPTER"
                        android:textColor="#626D89"
                        android:textSize="8sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.10" />

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BOSS"
                    android:textColor="#A78BFA"
                    android:textSize="8sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.12" />

            </LinearLayout>

            <!-- ================================================= -->
            <!-- BOSS CARD                                         -->
            <!-- ================================================= -->

            <TextView
                android:id="@+id/challengeText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="#11152A"
                android:padding="20dp"
                android:text="⚔  Complete the chapter challenge"
                android:textColor="#F5F7FF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:lineSpacingExtra="4dp"
                android:clickable="true"
                android:focusable="true" />

            <!-- ================================================= -->
            <!-- GAME FOOTER                                       -->
            <!-- ================================================= -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:gravity="center"
                android:text="✦  NOVA  •  EVERY QUEST UNLOCKS A NEW WORLD  ✦"
                android:textColor="#3F4963"
                android:textSize="8sp"
                android:textStyle="bold"
                android:letterSpacing="0.14" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
