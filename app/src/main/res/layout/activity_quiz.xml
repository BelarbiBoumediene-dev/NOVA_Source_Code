<?xml version="1.0" encoding="utf-8"?>

<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_quiz_arena"
    android:fillViewport="true"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="40dp">

        <!-- ================================================= -->
        <!-- NOVA HEADER -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp">

                <ImageView
                    android:id="@+id/playerAvatar"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/img1"
                    android:scaleType="centerInside"
                    android:contentDescription="NOVA" />

                <View
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="#22000000" />

            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NOVA"
                    android:textColor="#F5F7FF"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.10" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="AI QUEST"
                    android:textColor="#A78BFA"
                    android:textSize="8sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.18" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="QUIZ"
                android:textColor="#626D89"
                android:textSize="9sp"
                android:textStyle="bold"
                android:letterSpacing="0.16" />

        </LinearLayout>


        <!-- ================================================= -->
        <!-- PROGRESS -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="KNOWLEDGE TEST"
                    android:textColor="#78839F"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.16" />

                <TextView
                    android:id="@+id/questionCounter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Question 1 / 1"
                    android:textColor="#6EA8FF"
                    android:textSize="10sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <ProgressBar
                android:id="@+id/ProgressBar"
                android:layout_width="match_parent"
                android:layout_height="5dp"
                android:layout_marginTop="9dp"
                android:max="100"
                android:progress="0"
                android:progressTint="#4F8CFF"
                android:progressBackgroundTint="#263452"
                style="?android:attr/progressBarStyleHorizontal" />

        </LinearLayout>


        <!-- ================================================= -->
        <!-- QUESTION CARD -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:orientation="vertical"
            android:padding="22dp"
            android:background="@drawable/bg_arena_panel">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">

                <View
                    android:layout_width="5dp"
                    android:layout_height="5dp"
                    android:background="#8B5CF6" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="CURRENT CHALLENGE"
                    android:textColor="#A78BFA"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.17" />

            </LinearLayout>

            <TextView
                android:id="@+id/questionText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:text="Question..."
                android:textColor="#F5F7FF"
                android:textSize="23sp"
                android:textStyle="bold"
                android:lineSpacingExtra="3dp" />

        </LinearLayout>


        <!-- ================================================= -->
        <!-- ANSWERS -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="23dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SELECT YOUR ANSWER"
                android:textColor="#78839F"
                android:textSize="9sp"
                android:textStyle="bold"
                android:letterSpacing="0.16" />

            <RadioGroup
                android:id="@+id/optionsGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical" />

        </LinearLayout>


        <!-- ================================================= -->
        <!-- FEEDBACK -->
        <!-- ================================================= -->

        <TextView
            android:id="@+id/feedbackText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_archive_panel"
            android:padding="18dp"
            android:text=""
            android:textColor="#DCE2F2"
            android:textSize="14sp"
            android:lineSpacingExtra="4dp"
            android:visibility="gone" />


        <!-- ================================================= -->
        <!-- CHECK BUTTON -->
        <!-- ================================================= -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/checkButton"
            style="@style/Widget.Quizz.PremiumButton"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="22dp"
            android:text="CHECK ANSWER   →"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:backgroundTint="#4F8CFF"
            app:cornerRadius="18dp"
            app:rippleColor="#4075D6" />


        <!-- ================================================= -->
        <!-- HELPER TEXT -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="Choose carefully • Every answer shapes your progress"
            android:textColor="#626D89"
            android:textSize="9sp" />


        <!-- ================================================= -->
        <!-- FOOTER -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center"
            android:text="NOVA  •  EVERY GOAL IS A QUEST"
            android:textColor="#4F5A75"
            android:textSize="8sp"
            android:textStyle="bold"
            android:letterSpacing="0.16" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
