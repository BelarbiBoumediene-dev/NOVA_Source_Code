<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_world_map"
    tools:context=".MyJourneysActivity">

    <!-- ========================================================= -->
    <!-- BACKGROUND                                                 -->
    <!-- ========================================================= -->

    <ImageView
        android:id="@+id/gameBackground"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/a"
        android:scaleType="centerCrop"
        android:alpha="0.20"
        android:contentDescription="@null"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#E8070B18"
        android:clickable="false"
        android:focusable="false"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- ========================================================= -->
    <!-- MAIN SCROLL                                                -->
    <!-- ========================================================= -->

    <androidx.core.widget.NestedScrollView
        android:id="@+id/mainScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="8dp"
        android:paddingBottom="108dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">


            <!-- ================================================= -->
            <!-- PAGE HEADER                                       -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:paddingTop="22dp"
                android:paddingBottom="18dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="YOUR ADVENTURES"
                        android:textColor="#707B97"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.20" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="MY JOURNEYS"
                        android:textColor="#F5F7FF"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.02" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Continue your learning adventures."
                        android:textColor="#7EA8FF"
                        android:textSize="11sp" />

                </LinearLayout>

                <TextView
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_game_icon_button"
                    android:gravity="center"
                    android:text="📚"
                    android:textColor="#A78BFA"
                    android:textSize="24sp" />

            </LinearLayout>


            <!-- ================================================= -->
            <!-- MISSION ARCHIVE                                   -->
            <!-- ================================================= -->

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_archive_panel"
                android:clipToOutline="true">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/m"
                    android:scaleType="centerCrop"
                    android:alpha="0.20"
                    android:contentDescription="@null" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#70101A30" />

                <!-- holographic orb -->

                <View
                    android:layout_width="78dp"
                    android:layout_height="78dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="18dp"
                    android:layout_marginEnd="24dp"
                    android:alpha="0.55"
                    android:background="@drawable/bg_hologram_orb" />

                <View
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="bottom|end"
                    android:layout_marginBottom="24dp"
                    android:layout_marginEnd="108dp"
                    android:alpha="0.45"
                    android:background="@drawable/bg_hologram_orb" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="bottom"
                    android:orientation="vertical"
                    android:padding="19dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="#332E6CFF"
                        android:paddingStart="10dp"
                        android:paddingTop="5dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="5dp"
                        android:text="MISSION ARCHIVE  •  ONLINE"
                        android:textColor="#B9D1FF"
                        android:textSize="8sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.12" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="YOUR WORLDS,\nALL IN ONE PLACE."
                        android:textColor="#FFFFFF"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:lineSpacingExtra="0dp" />

                </LinearLayout>





                <TextView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="16dp"
                    android:layout_marginEnd="16dp"
                    android:background="@drawable/bg_archive_panel"
                    android:gravity="center"
                    android:text="✦"
                    android:textColor="#A78BFA"
                    android:textSize="24sp" />





            </FrameLayout>


            <!-- ================================================= -->
            <!-- NEW QUEST BUTTON                                  -->
            <!-- ================================================= -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/createJourneyButton"
                style="@style/Widget.Quizz.GenerateButton"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="18dp"
                android:text="START NEW QUEST"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:letterSpacing="0.07"
                android:backgroundTint="#4F8CFF"
                android:visibility="gone"
                app:icon="@drawable/ic_sparkle"
                app:iconTint="#FFFFFF"
                app:iconGravity="textStart"
                app:iconPadding="10dp" />


            <!-- ================================================= -->
            <!-- SECTION HEADER                                    -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="3dp"
                    android:layout_height="16dp"
                    android:background="#4F8CFF" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:text="YOUR QUESTS"
                    android:textColor="#A8B4CE"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.16" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✦"
                    android:textColor="#8B5CF6"
                    android:textSize="17sp" />

            </LinearLayout>


            <!-- ================================================= -->
            <!-- EMPTY STATE                                      -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/emptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="34dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✦"
                    android:textColor="#8B5CF6"
                    android:textSize="38sp" />

                <TextView
                    android:id="@+id/emptyText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:text="NO QUESTS YET"
                    android:textColor="#F5F7FF"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:gravity="center"
                    android:text="Create your first learning adventure."
                    android:textColor="#78839F"
                    android:textSize="12sp" />

            </LinearLayout>


            <!-- ================================================= -->
            <!-- DYNAMIC JOURNEYS                                 -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/journeysContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:orientation="vertical" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>


    <!-- ========================================================= -->
    <!-- BOTTOM GAME NAVIGATION                                   -->
    <!-- ========================================================= -->

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bottomNavigation"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="10dp"
        android:elevation="14dp"
        app:cardBackgroundColor="#0B1020"
        app:cardCornerRadius="23dp"
        app:strokeColor="#24314C"
        app:strokeWidth="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="5dp"
            android:paddingEnd="5dp">


            <!-- HOME -->

            <LinearLayout
                android:id="@+id/navHome"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_home"
                    android:tint="#626D89"
                    android:scaleType="fitCenter"
                    android:contentDescription="Home" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="HOME"
                    android:textColor="#626D89"
                    android:textSize="8sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.10" />

            </LinearLayout>


            <!-- JOURNEYS - ACTIVE -->

            <LinearLayout
                android:id="@+id/navJourneys"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_journeys"
                    android:tint="#6EA8FF"
                    android:scaleType="fitCenter"
                    android:contentDescription="Journeys" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="JOURNEYS"
                    android:textColor="#6EA8FF"
                    android:textSize="8sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.10" />

            </LinearLayout>


            <!-- TROPHIES -->

            <LinearLayout
                android:id="@+id/navAchievements"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_trophy"
                    android:tint="#626D89"
                    android:scaleType="fitCenter"
                    android:contentDescription="Trophies" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="TROPHIES"
                    android:textColor="#626D89"
                    android:textSize="8sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.10" />

            </LinearLayout>


            <!-- RANK -->

            <LinearLayout
                android:id="@+id/navNova"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_crown"
                    android:tint="#626D89"
                    android:scaleType="fitCenter"
                    android:contentDescription="Rank" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="RANK"
                    android:textColor="#626D89"
                    android:textSize="8sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.10" />

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>

