<?xml version="1.0" encoding="utf-8"?>

<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_learning"
    android:fillViewport="true"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="40dp">

        <!-- ================================================= -->
        <!-- HEADER -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Nova Avatar -->

            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp">

                <ImageView
                    android:id="@+id/playerAvatar"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/img1"
                    android:scaleType="centerCrop" />

                <View
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="#22000000" />

            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NOVA"
                    android:textColor="#F5F7FF"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.10" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="AI QUEST"
                    android:textColor="#78839F"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.18" />

            </LinearLayout>

            <!-- Lesson Number -->

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LESSON"
                    android:textColor="#626D89"
                    android:textSize="8sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.16" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="1dp"
                    android:text="01"
                    android:textColor="#6EA8FF"
                    android:textSize="21sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>


        <!-- ================================================= -->
        <!-- TOP PROGRESS -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="QUEST PROGRESS"
                    android:textColor="#78839F"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.16" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="01 / 01"
                    android:textColor="#6EA8FF"
                    android:textSize="9sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <ProgressBar
                android:layout_width="match_parent"
                android:layout_height="5dp"
                android:layout_marginTop="9dp"
                android:max="100"
                android:progress="100"
                android:progressTint="#4F8CFF"
                android:progressBackgroundTint="#263452"
                style="?android:attr/progressBarStyleHorizontal" />

        </LinearLayout>


        <!-- ================================================= -->
        <!-- LESSON HERO -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:orientation="vertical"
            android:padding="22dp"
            android:background="@drawable/bg_logo">

            <!-- Identity -->

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="5dp"
                    android:layout_height="5dp"
                    android:background="#8B5CF6" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="ACTIVE LESSON"
                    android:textColor="#A78BFA"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.16" />

            </LinearLayout>

            <TextView
                android:id="@+id/lessonTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Your First Kotlin Code"
                android:textColor="#F5F7FF"
                android:textSize="27sp"
                android:textStyle="bold"
                android:lineSpacingExtra="2dp" />

            <!-- Metadata -->

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/lessonTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="15 min"
                    android:textColor="#6EA8FF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="9dp"
                    android:text="•"
                    android:textColor="#3D4965"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="9dp"
                    android:text="BEGINNER"
                    android:textColor="#78839F"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.12" />

            </LinearLayout>

        </LinearLayout>


        <!-- ================================================= -->
        <!-- LEARN -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="@drawable/bg_logo">

            <!-- Section Header -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:gravity="center"
                    android:text="01"
                    android:textColor="#F5F7FF"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_logo" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="LEARN"
                        android:textColor="#6EA8FF"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.15" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="CORE KNOWLEDGE"
                        android:textColor="#4F5A75"
                        android:textSize="7sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.10" />

                </LinearLayout>

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:background="#1F2A42" />

            <TextView
                android:id="@+id/lessonContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Lesson content..."
                android:textColor="#DCE2F2"
                android:textSize="16sp"
                android:lineSpacingExtra="6dp" />

        </LinearLayout>


        <!-- ================================================= -->
        <!-- EXAMPLE -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="@drawable/bg_logo">

            <!-- Section Header -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:gravity="center"
                    android:text="02"
                    android:textColor="#F5F7FF"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_logo" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="EXAMPLE"
                        android:textColor="#A78BFA"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.15" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="SEE IT IN ACTION"
                        android:textColor="#4F5A75"
                        android:textSize="7sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.10" />

                </LinearLayout>

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:background="#1F2A42" />

            <TextView
                android:id="@+id/lessonExample"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Example..."
                android:textColor="#DCE2F2"
                android:textSize="15sp"
                android:lineSpacingExtra="5dp" />

        </LinearLayout>


        <!-- ================================================= -->
        <!-- PRACTICE -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="@drawable/bg_logo">

            <!-- Section Header -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:gravity="center"
                    android:text="03"
                    android:textColor="#F5F7FF"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_logo" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PRACTICE"
                        android:textColor="#6EA8FF"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.15" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="PREPARE FOR THE CHALLENGE"
                        android:textColor="#4F5A75"
                        android:textSize="7sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08" />

                </LinearLayout>

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:background="#1F2A42" />

            <TextView
                android:id="@+id/lessonPractice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Practice..."
                android:textColor="#DCE2F2"
                android:textSize="15sp"
                android:lineSpacingExtra="5dp" />

        </LinearLayout>


        <!-- ================================================= -->
        <!-- QUIZ CTA -->
        <!-- ================================================= -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/practiceButton"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="24dp"
            android:text="START QUIZ   ›"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:backgroundTint="#4F8CFF"
            app:cornerRadius="18dp"
            app:rippleColor="#4075D6" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="11dp"
            android:gravity="center"
            android:text="Complete the lesson to unlock the quiz"
            android:textColor="#626D89"
            android:textSize="9sp" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
