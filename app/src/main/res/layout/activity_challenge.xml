<?xml version="1.0" encoding="utf-8"?>

<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_quiz_arena"
    android:fillViewport="true"
    android:clipToPadding="false">




    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="00dp"
        android:paddingBottom="32dp">


        <!-- ================================================= -->
        <!-- CHALLENGE LABEL -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="34dp"
            android:text="⚔  FINAL CHALLENGE"
            android:textColor="#6EA8FF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.12" />


        <!-- ================================================= -->
        <!-- CHALLENGE TITLE -->
        <!-- ================================================= -->

        <TextView
            android:id="@+id/challengeTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Challenge"
            android:textColor="#F5F7FF"
            android:textSize="30sp"
            android:textStyle="bold"
            android:lineSpacingExtra="2dp" />


        <!-- ================================================= -->
        <!-- CHALLENGE TYPE -->
        <!-- ================================================= -->

        <TextView
            android:id="@+id/challengeType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="CHALLENGE"
            android:textColor="#A78BFA"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.10" />


        <!-- ================================================= -->
        <!-- MISSION CARD -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:background="@drawable/bg_arena_panel"
            android:orientation="vertical"
            android:padding="22dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="YOUR MISSION"
                android:textColor="#A78BFA"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.12" />

            <TextView
                android:id="@+id/challengeDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Complete the challenge."
                android:textColor="#F5F7FF"
                android:textSize="17sp"
                android:lineSpacingExtra="6dp" />

        </LinearLayout>


        <!-- ================================================= -->
        <!-- QUESTION AREA -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:orientation="vertical">

            <!-- QUESTION HEADER -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="5dp"
                    android:layout_height="22dp"
                    android:background="#4F8CFF"
                    android:text="" />

                <TextView
                    android:id="@+id/questionCounter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="CHALLENGE QUESTION 1 / 2"
                    android:textColor="#6EA8FF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />

            </LinearLayout>


            <!-- QUESTION -->

            <TextView
                android:id="@+id/questionText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Question"
                android:textColor="#F5F7FF"
                android:textSize="22sp"
                android:textStyle="bold"
                android:lineSpacingExtra="5dp" />

        </LinearLayout>


        <!-- ================================================= -->
        <!-- ANSWERS -->
        <!-- ================================================= -->

        <RadioGroup
            android:id="@+id/optionsGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:orientation="vertical" />


        <!-- ================================================= -->
        <!-- FEEDBACK -->
        <!-- ================================================= -->

        <TextView
            android:id="@+id/feedbackText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_logo"
            android:padding="20dp"
            android:textColor="#F5F7FF"
            android:textSize="15sp"
            android:lineSpacingExtra="5dp"
            android:visibility="gone" />


        <!-- ================================================= -->
        <!-- COMPLETE / CHECK BUTTON -->
        <!-- ================================================= -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/completeButton"
            style="@style/Widget.Quizz.PremiumButton"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="24dp"
            android:text="CHECK ANSWER   →"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:letterSpacing="0.04"
            android:backgroundTint="#4F8CFF"
            app:cornerRadius="18dp"
            app:elevation="4dp" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
