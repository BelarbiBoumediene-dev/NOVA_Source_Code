<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <set android:ordering="together">
            <objectAnimator android:propertyName="elevation" android:valueTo="2dp" android:duration="70" />
            <objectAnimator android:propertyName="translationZ" android:valueTo="0dp" android:duration="70" />
        </set>
    </item>
    <item>
        <set android:ordering="together">
            <objectAnimator android:propertyName="elevation" android:valueTo="6dp" android:duration="140" />
            <objectAnimator android:propertyName="translationZ" android:valueTo="2dp" android:duration="140" />
        </set>
    </item>
</selector>
