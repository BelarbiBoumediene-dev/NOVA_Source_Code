<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <set>

            <objectAnimator
                android:duration="80"
                android:propertyName="scaleX"
                android:valueFrom="1"
                android:valueTo="0.92" />

            <objectAnimator
                android:duration="80"
                android:propertyName="scaleY"
                android:valueFrom="1"
                android:valueTo="0.92" />

        </set>
    </item>

    <item>
        <set>

            <objectAnimator
                android:duration="120"
                android:propertyName="scaleX"
                android:valueFrom="0.96"
                android:valueTo="1" />

            <objectAnimator
                android:duration="120"
                android:propertyName="scaleY"
                android:valueFrom="0.96"
                android:valueTo="1" />

        </set>
    </item>

</selector>